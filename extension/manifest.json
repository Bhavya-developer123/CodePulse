{
    "manifest_version": 3,

    "name": "CodePulse",

    "version": "1.1.0",

    "description": "Track coding problems directly from coding platforms.",

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "http://localhost:8080/*"
    ],

    "action": {
        "default_popup": "popup.html"
    }
}